{
  "name": "anilibrix",
  "version": "2.0.0",
  "author": {
    "name": "Anilibria",
    "email": "anilibria@protonmail.com",
    "url": "https://anilibria.tv"
  },
  "description": "AniLibrix Prime - AniLibria desktop app (Anilibrix fork)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/KEYTRON/anilibrix-prime"
  },
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "release": "npm run build && electron-builder -wml -c.compression=store --publish never",
    "release:mac": "npm run proxies-download && npm run build && electron-builder -m -c.compression=store --publish never",
    "release:linux": "npm run proxies-download && npm run build && electron-builder -l -c.compression=store --publish never",
    "release:windows": "npm run proxies-download && npm run build && electron-builder -w -c.compression=maximum --publish never",
    "proxies-download": "./scripts/opera-proxy.sh && ./scripts/forward-proxy.sh",
    "create-icons": "./scripts/icon-gen.sh",
    "lint": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix"
  },
  "meta": {
    "name": "AniLibrix",
    "links": {
      "github": "https://github.com/KEYTRON/anilibrix-prime",
      "donate": "https://www.anilibria.tv/pages/donate.php",
      "telegram": "tg://resolve?domain=anilibrix",
      "anilibria": "https://anilibria.tv"
    }
  },
  "build": {
    "productName": "AniLibrix Prime",
    "artifactName": "AniLibrixPrime-${os}-${arch}-${version}.${ext}",
    "appId": "com.anilibria.anilibrix",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "build/${os}/${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons/app",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icons/app/icon.icns",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icons/app/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons/app",
      "executableName": "anilibrix-prime",
      "category": "AudioVideo;Video;Player;",
      "desktop": {
        "StartupWMClass": "anilibrix-prime"
      },
      "target": [
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "flatpak": {
      "finishArgs": [
        "--filesystem=xdg-run/discord-ipc-0",
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications"
      ]
    },
    "snap": {
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "x11",
        "wayland",
        "unity7",
        "browser-support",
        "network",
        "gsettings",
        "audio-playback",
        "pulseaudio",
        "opengl",
        "system-observe",
        "screen-inhibit-control"
      ],
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        },
        {
          "repo": "anilibrix",
          "channels": [
            "stable"
          ],
          "provider": "snapStore",
          "publishAutoUpdate": false
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "artifactName": "${productName}-${os}-${version}-setup.${ext}",
      "installerSidebar": "build/installer/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@mdi/font": "^7.4.47",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@xhayper/discord-rpc": "^1.3.3",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.9",
    "content-disposition-attachment": "^0.3.1",
    "cross-spawn": "^7.0.6",
    "dayjs": "^1.11.13",
    "debug": "^4.3.7",
    "electron-promise-ipc": "^2.0.1",
    "electron-store": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.2",
    "flatted": "^3.3.2",
    "form-data": "^4.0.1",
    "fuse.js": "^7.0.0",
    "get-port": "^5.1.1",
    "hls.js": "^1.5.18",
    "human-format": "^1.2.0",
    "isomorphic-fetch": "^3.0.0",
    "lethargy": "^1.0.9",
    "lodash": "^4.17.21",
    "logrotate-stream": "^0.2.9",
    "magnet2torrent-js": "^1.4.0",
    "matroska-subtitles": "^3.3.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "node-global-proxy": "^1.0.1",
    "node-gyp": "^10.2.0",
    "parse-torrent": "^9.1.5",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "plyr": "^3.7.8",
    "pretty-bytes": "^6.1.1",
    "rimraf": "^6.0.1",
    "screenfull": "^6.0.2",
    "set-cookie-parser": "^2.7.1",
    "string-strip-html": "^13.4.8",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^3.7.4",
    "webtorrent": "^2.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "sass": "^1.83.4",
    "vite": "^6.0.11",
    "vite-plugin-vuetify": "^2.1.1"
  }
}
